<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.github.daikichiba9511.update-tools</string>
  <key>ProgramArguments</key>
  <array>
    <string>{{ .chezmoi.sourceDir }}/bin/update-tools</string>
  </array>
  <!-- スリープ中に時刻を過ぎた場合は、復帰後に1回だけ実行される -->
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key>
    <integer>8</integer>
    <key>Minute</key>
    <integer>30</integer>
  </dict>
  <key>StandardOutPath</key>
  <string>{{ .chezmoi.homeDir }}/Library/Logs/update-tools.log</string>
  <key>StandardErrorPath</key>
  <string>{{ .chezmoi.homeDir }}/Library/Logs/update-tools.log</string>
</dict>
</plist>
